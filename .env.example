# Server-side only (Vercel Project → Settings → Environment Variables).
# Copy this file, fill values locally if needed, and NEVER commit real secrets.
# No VITE_* prefix: none of these values may be bundled into client-side JavaScript.

# Optional image-analysis fallback for /api/analyze (empty = provider disabled).
HF_TOKEN=
NYCKEL_CLIENT_ID=
NYCKEL_CLIENT_SECRET=
BIRDNET_SPACE_URL=

# Optional tuning for /api/analyze bird gate (defaults shown).
DISABLE_BIRD_GATE=0
BIRD_GATE_MIN_SCORE=0.30
MIN_SPECIES_SCORE=0.35
